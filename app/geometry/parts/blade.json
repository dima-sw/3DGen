{
  "name": "blade",
  "category": "organic",
  "description": "Superficie sottile con vero bordo d'attacco: pinna, membrana alare, cresta, orecchio. La corda si controlla alla base, a meta' e alla punta, quindi la stessa ricetta fa sia una dorsale che si chiude sia una caudale che si apre. Con fork > 0 la punta si incava",
  "material": "skin",
  "tags": [
    "fin"
  ],
  "keywords": [
    "pinna",
    "ala",
    "membrana",
    "cresta",
    "orecchio",
    "coda"
  ],
  "params": {
    "length": {
      "default": 0.3,
      "min": 0.02,
      "max": 3.0,
      "vary": 0.14,
      "desc": "sviluppo dalla base"
    },
    "width": {
      "default": 0.22,
      "min": 0.02,
      "max": 2.0,
      "vary": 0.16,
      "desc": "corda: estensione trasversale alla base"
    },
    "thickness": {
      "default": 0.03,
      "min": 0.004,
      "max": 0.4,
      "vary": 0.18,
      "desc": "spessore della lama, da bordo a bordo"
    },
    "bend": {
      "default": 0.2,
      "min": -4.0,
      "max": 4.0,
      "vary": 0.28,
      "desc": "curvatura sul piano della lama"
    },
    "fork": {
      "default": 0.0,
      "min": 0.0,
      "max": 1.2,
      "vary": 0.22,
      "desc": "0 = punta piena, >0 = incavo fra due lobi"
    },
    "sweep": {
      "default": 0.0,
      "min": -1.0,
      "max": 1.0,
      "vary": 0.28,
      "desc": "inclinazione all'indietro, in frazione di 45 gradi"
    },
    "root": {
      "default": 0.45,
      "min": 0.1,
      "max": 1.0,
      "vary": 0.14,
      "desc": "quanto e' larga la lama gia' all'attacco"
    },
    "tip": {
      "default": 0.4,
      "min": 0.05,
      "max": 2.5,
      "vary": 0.16,
      "desc": "corda alla punta, in frazione di width: sotto 1 la lama si chiude (dorsale), sopra 1 si apre (caudale)"
    },
    "belly": {
      "default": 1.0,
      "min": 0.4,
      "max": 1.8,
      "vary": 0.12,
      "desc": "corda a meta' lama, in frazione di width"
    }
  },
  "shape": {
    "op": "rotate",
    "angles": [
      0,
      0,
      "-sweep*45"
    ],
    "child": {
      "op": "bend",
      "amount": "bend",
      "axis": 0,
      "around": 2,
      "child": {
        "difference": {
          "comment": "la lama: corda che cresce, si allarga e poi si assottiglia; lo spessore cala sempre, ed e' questo a dare il bordo d'attacco",
          "op": "translate",
          "offset": [
            "length*0.5",
            0,
            0
          ],
          "child": {
            "volume": "profile",
            "length": "length*0.5",
            "smooth": true,
            "stations": [
              [
                "0.00",
                "width*root*0.72",
                "thickness*0.50"
              ],
              [
                "0.10",
                "width*root",
                "thickness*0.49"
              ],
              [
                "0.34",
                "width*(root + (belly-root)*0.80)",
                "thickness*0.45"
              ],
              [
                "0.55",
                "width*belly",
                "thickness*0.38"
              ],
              [
                "0.75",
                "width*(belly + (tip-belly)*0.45)",
                "thickness*0.28"
              ],
              [
                "0.90",
                "width*(belly + (tip-belly)*0.80)",
                "thickness*0.18"
              ],
              [
                "1.00",
                "width*tip",
                "thickness*0.09"
              ]
            ]
          }
        },
        "tool": {
          "comment": "incavo della coda biforcuta: un cuneo tolto dalla punta",
          "op": "translate",
          "offset": [
            "length*(1.02 + fork*0.10)",
            0,
            0
          ],
          "child": {
            "volume": "profile",
            "length": "max(length*fork*0.55, 0.0005)",
            "smooth": false,
            "stations": [
              [
                "0.00",
                "max(width*0.02, 0.0004)",
                "thickness*2.0"
              ],
              [
                "1.00",
                "max(width*fork*0.95, 0.0006)",
                "thickness*2.0"
              ]
            ]
          }
        },
        "blend": "thickness*0.35"
      }
    }
  },
  "sockets": [
    {
      "name": "base",
      "position": [
        0,
        0,
        0
      ],
      "direction": [
        -1,
        0,
        0
      ],
      "up": [
        0,
        1,
        0
      ],
      "radius": "max(thickness*2.2, width*root*0.40)",
      "kind": "fin"
    },
    {
      "name": "tip",
      "position": [
        "length*1.05",
        0,
        0
      ],
      "direction": [
        1,
        0,
        0
      ],
      "up": [
        0,
        1,
        0
      ],
      "radius": "width*0.22",
      "kind": "fin"
    }
  ]
}
