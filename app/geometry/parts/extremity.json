{
  "name": "extremity",
  "category": "organic",
  "description": "Estremita: mano, piede, zampa. Con pitch a 90 gradi si stacca dall'asse dell'arto e punta in avanti, che e' come sta un piede rispetto alla gamba",
  "material": "skin",
  "tags": ["extremity", "hand"],
  "keywords": ["mano", "piede", "zampa", "artiglio"],
  "params": {
    "length":    {"default": 0.11,  "min": 0.01,  "max": 1.0, "vary": 0.14,
                  "desc": "sviluppo dalla caviglia alla punta"},
    "width":     {"default": 0.07,  "min": 0.01,  "max": 0.8, "vary": 0.14,
                  "desc": "larghezza massima"},
    "thickness": {"default": 0.035, "min": 0.005, "max": 0.4, "vary": 0.18,
                  "desc": "spessore"},
    "pitch":     {"default": 0.0,   "min": -110.0, "max": 110.0, "vary": 0.0,
                  "desc": "gradi di scarto dall'asse dell'arto: 0 = mano che continua il braccio, 90 = piede che punta avanti"},
    "heel":      {"default": 0.0,   "min": 0.0,   "max": 0.8, "vary": 0.10,
                  "desc": "quanto sporge dietro l'attacco, in frazione di length"},
    "toe":       {"default": 0.55,  "min": 0.15,  "max": 1.2, "vary": 0.14,
                  "desc": "larghezza alla punta, in frazione di width"}
  },
  "shape": {
    "comment": "prima si gira nel verso giusto, poi si arretra sul tallone",
    "op": "rotate",
    "angles": [0, 0, "-pitch"],
    "child": {
      "op": "translate",
      "offset": ["length*(0.5 - heel)", 0, 0],
      "child": {
        "volume": "profile",
        "length": "length*0.5",
        "smooth": true,
        "stations": [
          ["0.00", "thickness*0.80", "width*0.62"],
          ["0.18", "thickness*1.00", "width*0.82"],
          ["0.45", "thickness*0.94", "width*0.98"],
          ["0.70", "thickness*0.78", "width*1.00"],
          ["0.88", "thickness*0.58", "width*toe*1.10"],
          ["1.00", "thickness*0.38", "width*toe*0.80"]
        ]
      }
    }
  },
  "sockets": [
    {"name": "base", "position": [0, 0, 0], "direction": [-1, 0, 0], "up": [0, 1, 0],
     "radius": "max(width*0.55, thickness*1.2)", "kind": "limb"},

    {"name": "tip",
     "position": ["length*(1 - heel)*cos(radians(pitch))",
                  "-length*(1 - heel)*sin(radians(pitch))", 0],
     "direction": ["cos(radians(pitch))", "-sin(radians(pitch))", 0],
     "up": [0, 1, 0], "radius": "width*toe*0.5", "kind": "limb"}
  ]
}
