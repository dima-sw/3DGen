{
  "name": "segment",
  "category": "structural",
  "description": "Volume squadrato smussato: cassoni, scafi, blocchi, basi meccaniche",
  "material": "metal",
  "tags": ["segment", "structure"],
  "keywords": ["blocco", "cassone", "scatola", "sezione"],
  "params": {
    "length":   {"default": 0.40, "min": 0.02, "max": 8.0, "vary": 0.12},
    "height":   {"default": 0.20, "min": 0.01, "max": 5.0, "vary": 0.12},
    "width":    {"default": 0.25, "min": 0.01, "max": 5.0, "vary": 0.12},
    "rounding": {"default": 0.030, "min": 0.0, "max": 0.5, "vary": 0.25},
    "taper":    {"default": 0.0, "min": -0.9, "max": 0.9, "vary": 0.20}
  },
  "shape": {
    "op": "taper", "amount": "taper / max(length, 0.05) * 0.8", "axis": 0,
    "child": {"op": "translate", "offset": ["length*0.5", 0, 0],
              "child": {"volume": "box", "size": ["length", "height*2", "width*2"], "rounding": "rounding"}}
  },
  "sockets": [
    {"name": "base",  "position": [0, 0, 0], "direction": [-1, 0, 0], "up": [0, 1, 0], "radius": "height*0.8", "kind": "structure"},
    {"name": "tip",   "position": ["length", 0, 0], "direction": [1, 0, 0], "up": [0, 1, 0], "radius": "height*0.8", "kind": "structure"},
    {"name": "top",   "position": ["length*0.5", "height", 0], "direction": [0, 1, 0], "up": [-1, 0, 0], "radius": "height*0.6", "kind": "structure"},
    {"name": "side",  "arrangement": "pair", "axis": 2, "position": ["length*0.5", 0, "width"], "direction": [0, 0, 1], "up": [0, 1, 0], "radius": "height*0.6", "kind": "structure"}
  ]
}
