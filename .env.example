# Copia questo file in ".env" e inserisci le tue chiavi.
# NON mettere chiavi vere qui: .env.example non e' ignorato da git, .env si'.

# --- Catena di failover dei provider LLM ------------------------------------
# Vengono provati in ordine: il primo che risponde con JSON valido vince.
# Se falliscono tutti si passa al planner a regole locale (nessun costo, nessuna rete).
# Provider validi: groq, gemini, mistral, openrouter, cohere, huggingface, ollama,
#                  openai, deepseek, offline
GEN3D_LLM_CHAIN=groq,gemini,mistral,openrouter,cohere,huggingface,ollama

# --- Groq (gratuito, molto veloce) ------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Google Gemini (free tier ampio) ----------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Mistral (piano Experiment gratuito) ------------------------------------
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- OpenRouter (usare modelli con suffisso :free) --------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Cohere (trial gratuito) ------------------------------------------------
COHERE_API_KEY=
COHERE_MODEL=command-r7b-12-2024

# --- HuggingFace (credito mensile gratuito limitato) ------------------------
HF_API_KEY=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# --- Ollama (100% locale, nessuna chiave) -----------------------------------
# Su GTX 1660 Ti 6 GB restare su modelli 7B quantizzati.
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- A pagamento: fuori dalla catena predefinita ----------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Generazione ------------------------------------------------------------
GEN3D_LOG_LEVEL=INFO
GEN3D_OUTPUT_DIR=output
GEN3D_LIBRARY_DIR=library
GEN3D_TIMEOUT=60
