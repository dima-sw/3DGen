# Copia questo file in ".env" e inserisci le tue chiavi.
# NON mettere chiavi vere qui: .env.example non e' ignorato da git, .env si'.

# --- Catena di failover dei provider LLM ------------------------------------
# Vengono provati in ordine: il primo che risponde con JSON valido vince.
# Se falliscono tutti si passa al planner a regole locale (nessun costo, nessuna rete).
# Provider validi: groq, gemini, mistral, cohere, huggingface, cloudflare,
#                  nvidia_nim, cerebras, openrouter, ollama, openai, deepseek, offline
# OpenRouter e' sempre normalizzato come ultimo remoto; Ollama resta ultimo.
GEN3D_LLM_CHAIN=groq,gemini,mistral,cohere,huggingface,cloudflare,nvidia_nim,cerebras,openrouter,ollama

# --- Groq (gratuito, molto veloce) ------------------------------------------
GROQ_API_KEY=

# --- Google Gemini (free tier ampio) ----------------------------------------
GEMINI_API_KEY=

# --- Mistral (piano Experiment gratuito) ------------------------------------
MISTRAL_API_KEY=

# --- Cloudflare Workers AI -----------------------------------------------
# Il token puo' anche essere fornito con il nome legacy cloudflare_api.
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Alias accettato se il valore nel .env e' nominato cloudflare_id.
cloudflare_id=

# --- NVIDIA NIM -----------------------------------------------------------
# Per NIM locale impostare NVIDIA_NIM_BASE_URL, es. http://localhost:8000/v1.
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=

# --- Cerebras -------------------------------------------------------------
# La chiave puo' anche essere fornita con il nome legacy cerebras_api.
CEREBRAS_API_KEY=

# --- OpenRouter (usare modelli con suffisso :free) --------------------------
OPENROUTER_API_KEY=

# --- Cohere (trial gratuito) ------------------------------------------------
COHERE_API_KEY=

# --- HuggingFace (credito mensile gratuito limitato) ------------------------
HF_API_KEY=

# --- Ollama (100% locale, nessuna chiave) -----------------------------------
# Su GTX 1660 Ti 6 GB restare su modelli 7B quantizzati.
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- A pagamento: fuori dalla catena predefinita ----------------------------
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# I vecchi *_MODEL remoti vengono letti solo per compatibilita' e ignorati:
# i modelli remoti sono scelti dal registry backend ProviderSpec.default_model.

# --- Generazione ------------------------------------------------------------
GEN3D_LOG_LEVEL=INFO
GEN3D_OUTPUT_DIR=output
GEN3D_LIBRARY_DIR=library
GEN3D_TIMEOUT=60
